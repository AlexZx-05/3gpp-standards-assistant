# An OpenAI-compatible API is optional. Without it, the API will abstain after retrieval.
# Choose one provider and use its matching key, endpoint, and model.
# Groq example: https://api.groq.com/openai/v1 + llama-3.3-70b-versatile
# xAI example:  https://api.x.ai/v1 + an xAI-supported model
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# Local Docker default. Qdrant can also be a managed instance.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=three_gpp_chunks

EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base
INGESTION_BATCH_SIZE=32
TOP_K_DENSE=20
TOP_K_BM25=20
TOP_K_RERANK=5
MIN_EVIDENCE_COUNT=1
MIN_RERANK_SCORE=0.15
REQUEST_MAX_QUESTION_LENGTH=1000
